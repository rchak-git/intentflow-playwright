{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://intentflow.dev/schemas/intent-schema.json",
  "title": "IntentFlow Suite Specification Schema v1.0",
  "description": "JSON Schema governing IntentFlow DSL v1.0 YAML suite files for IDE IntelliSense and compile-time validation.",
  "type": "object",
  "required": ["uiMap"],
  "additionalProperties": false,
  "properties": {
    "page": {
      "type": "string",
      "description": "AUT route URL associated with this suite (e.g., '/login/index.php')."
    },
    "description": {
      "type": "string",
      "description": "High-level summary of the suite's purpose."
    },
    "uiMap": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "type": "string" }
        }
      ],
      "description": "Registered UI Map key or array of UI Map module path references."
    },
    "includes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of parent YAML suite files included for modular scenario inheritance."
    },
    "sharedScenarios": {
      "type": "object",
      "description": "Dictionary of reusable Tier 1 atomic sub-scenarios and Tier 2 composite workflows.",
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/definitions/TestScenario"
          },
          {
            "type": "array",
            "items": { "$ref": "#/definitions/PipelineStep" }
          }
        ]
      }
    },
    "profiles": {
      "type": "object",
      "description": "Named test execution profiles binding data variations to composite scenarios.",
      "additionalProperties": {
        "$ref": "#/definitions/TestDataProfile"
      }
    }
  },
  "definitions": {
    "Intent": {
      "type": "string",
      "enum": ["action", "populate", "verify", "extract", "custom", "REQUIRES_SDET_HANDOFF"],
      "description": "Primary Canonical Verb routing the step execution."
    },
    "SubIntent": {
      "type": "string",
      "enum": [
        "navigate",
        "setValue",
        "click",
        "select",
        "remove",
        "toggle",
        "append",
        "clear",
        "pressKey",
        "hover",
        "dblClick",
        "equals",
        "contains",
        "state",
        "urlContains",
        "jsClick",
        "cellText",
        "count",
        "rowCount",
        "clickSubControl",
        "sortColumn",
        "tableData",
        "allRowCheckboxesState",
        "optionsContains",
        "open",
        "close"
      ],
      "description": "Operation or widget-specific sub-intent verb."
    },
    "WidgetType": {
      "type": "string",
      "enum": [
        "WEB_TABLE",
        "TEXTBOX",
        "BUTTON",
        "DROPDOWN",
        "CHECKBOX",
        "RADIO_GROUP",
        "SELECT",
        "CUSTOM_SELECT",
        "CONTAINER",
        "CARD"
      ],
      "description": "Optional widget classification for capability enforcement."
    },
    "StateValue": {
      "type": "string",
      "enum": ["visible", "hidden", "enabled", "disabled"],
      "description": "Allowed UI element verification states."
    },
    "Scalar": {
      "oneOf": [
        { "type": "string" },
        { "type": "boolean" },
        { "type": "number" }
      ]
    },
    "StepParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subIntent": {
          "$ref": "#/definitions/SubIntent"
        },
        "value": {
          "oneOf": [
            { "$ref": "#/definitions/Scalar" },
            {
              "type": "array",
              "items": { "$ref": "#/definitions/Scalar" }
            }
          ],
          "description": "Input text, key name, boolean flag, array of choices, or expected assertion value."
        },
        "anchorText": {
          "type": "string",
          "description": "Row identifier or card anchor text for table and container targeting."
        },
        "column": {
          "type": "string",
          "description": "Target column key as defined in WebTableUiMapEntry."
        },
        "targetColumn": {
          "type": "string",
          "description": "Alternative alias for target column key."
        },
        "childWidget": {
          "type": "string",
          "description": "Sub-selector key for composite controls."
        },
        "handler": {
          "type": "string",
          "description": "Name of custom handler function when intent='custom'."
        },
        "timeout": {
          "type": "number",
          "description": "Action/verification polling timeout in milliseconds."
        },
        "force": {
          "type": "boolean",
          "description": "Bypass Playwright actionability checks during click/action."
        },
        "waitForNetwork": {
          "type": "boolean",
          "description": "Wait for network idle after executing step action."
        },
        "storeAs": {
          "type": "string",
          "description": "Key name to persist extracted value into runtime context store."
        },
        "reason": {
          "type": "string",
          "description": "SDET handoff reason code (e.g., UNSUPPORTED_CONTROL_OPERATION)."
        },
        "description": {
          "type": "string",
          "description": "Human-readable handoff context explanation."
        },
        "missingCapability": {
          "type": "string",
          "description": "Suggested missing subIntent or framework capability."
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "description": "Arbitrary contextual key-value pairs."
        }
      }
    },
    "StandardStep": {
      "type": "object",
      "required": ["fieldKey", "intent"],
      "additionalProperties": false,
      "properties": {
        "step": {
          "type": "string",
          "description": "Human-readable step annotation (e.g., Gherkin text)."
        },
        "fieldKey": {
          "type": "string",
          "description": "UI Map entry key targeting the web control."
        },
        "widgetType": {
          "$ref": "#/definitions/WidgetType"
        },
        "intent": {
          "$ref": "#/definitions/Intent"
        },
        "params": {
          "$ref": "#/definitions/StepParams"
        }
      }
    },
    "SdetHandoffStep": {
      "type": "object",
      "required": ["fieldKey", "intent"],
      "additionalProperties": false,
      "properties": {
        "step": {
          "type": "string",
          "description": "Human-readable step annotation."
        },
        "fieldKey": {
          "type": "string",
          "description": "UI Map entry key targeting the unsupported control."
        },
        "intent": {
          "type": "string",
          "enum": ["REQUIRES_SDET_HANDOFF"]
        },
        "params": {
          "$ref": "#/definitions/StepParams"
        }
      }
    },
    "RefScenarioStep": {
      "type": "object",
      "required": ["refScenario"],
      "additionalProperties": false,
      "properties": {
        "step": {
          "type": "string",
          "description": "Human-readable step annotation."
        },
        "refScenario": {
          "type": "string",
          "description": "Path or local key referencing a shared scenario."
        },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "description": "Parameter forwarding variable map for sub-scenario invocation."
        }
      }
    },
    "RefProfilePrecondition": {
      "type": "object",
      "required": ["refProfile"],
      "additionalProperties": false,
      "properties": {
        "step": {
          "type": "string",
          "description": "Human-readable precondition description."
        },
        "refProfile": {
          "type": "string",
          "description": "Referenced target profile key executed as a precondition."
        },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "description": "Scoped data overrides for referenced precondition profile."
        }
      }
    },
    "PipelineStep": {
      "oneOf": [
        { "$ref": "#/definitions/StandardStep" },
        { "$ref": "#/definitions/SdetHandoffStep" },
        { "$ref": "#/definitions/RefScenarioStep" }
      ]
    },
    "TestScenario": {
      "type": "object",
      "required": ["steps"],
      "additionalProperties": false,
      "properties": {
        "testName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PipelineStep"
          }
        }
      }
    },
    "TestDataProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RefProfilePrecondition"
          },
          "description": "Top-level precondition profiles (Rule 2.5)"
        },
        "refScenario": {
          "type": "string",
          "description": "Shared scenario key executed by this profile."
        },
        "refProfile": {
          "type": "string",
          "description": "Referenced target profile key executed by this profile."
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PipelineStep"
          },
          "description": "Inline step sequence executed directly by single-use profile (Rule 2.2)."
        },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "description": "Execution dataset bound to scenario parameters."
        }
      },
      "anyOf": [
        { "required": ["refScenario"] },
        { "required": ["refProfile"] },
        { "required": ["steps"] }
      ]
    }
  }
}