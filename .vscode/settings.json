{
  "yaml.schemas": {
    "./.vscode/intent-schema.json": [
      "**/suites/*.yaml",
      "**/suites/*.yml",
      "*.intent.yml",
      "*.intent.yaml"
    ]
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  }
}